<div class="card shadow-sm border-0 view">
  <div class="card-body p-4">
    <h4>Edit Contact</h4>

    <form id="contact-form">
      <input type="hidden" name="id" value="{{id}}">

      <input
          name="full_name"
          class="form-control mb-3"
          placeholder="Full Name"
          value="{{full_name}}"
      >

      <input
          name="email"
          type="email"
          class="form-control mb-3"
          placeholder="Email"
          value="{{email}}"
      >

      <input
          name="phone_number"
          type="tel"
          class="form-control mb-3"
          placeholder="Telephone"
          value="{{phone_number}}"
      >

      <input
          name="tags"
          class="form-control mb-3"
          placeholder="Tags"
          value="{{tags}}"
      >

      <button type="submit" class="btn btn-success">
          Submit
      </button>

      </form>
  </div>
</div>