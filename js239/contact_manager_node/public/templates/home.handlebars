<div class="view">
  <div class="row well mb-4">
    <div class="text-center col-sm-6">
      <a href="#contacts/new" class="btn btn-outline-success">Add Contact</a>
    </div>
    
    <div class="text-center col-sm-6">
      <input id="search" type="text" class="form-control contact-name-search" placeholder="Search">
    </div>
  </div>

  <div class="row cards-container">
    {{#each contacts}}
      <div class="contact-card col-md-3 col-sm-6 mb-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-3">
            <div class="d-flex justify-content-between gap-3">

              <div class="flex-grow-1 min-width-0">
                <h6 class="full-name card-title text-success-emphasis fw-semibold mb-3">
                  {{full_name}}
                </h6>

                <dl class="small mb-3">
                  <dt class="text-muted">Phone Number</dt>
                  <dd>{{phone_number}}</dd>

                  <dt class="text-muted">Email</dt>
                  <dd>{{email}}</dd>
                </dl>
              </div>

              <div class="d-flex flex-column align-items-end gap-1">
                {{#each tags}}
                  <button type="button"
                          class="badge bg-primary-subtle text-primary border-0 mb-1">
                    {{this}}
                  </button>
                {{/each}}
              </div>
            </div>

            <div class="d-flex gap-2">
              <a href="#contacts/edit/{{id}}"
                class="btn btn-sm btn-outline-success">Edit</a>

              <a href="#contacts/delete/{{id}}"
                class="btn btn-sm btn-outline-danger">Delete</a>
            </div>

          </div>
        </div>
      </div>
    {{else}}
      <div class="col-12">
        <p class="text-muted">No contacts added yet.</p>
      </div>
    {{/each}}
  </div>
</div>